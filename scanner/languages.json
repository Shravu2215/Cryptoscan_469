  "content_heuristics": [
    { "pattern": "^-----BEGIN RSA PRIVATE",   "language": "Private key" },
    { "pattern": "^-----BEGIN EC PRIVATE",    "language": "Private key" },
    { "pattern": "^-----BEGIN OPENSSH",       "language": "SSH key" },
    { "pattern": "^-----BEGIN ",              "language": "Certificate" },
    { "pattern": "ssh-rsa |ssh-ed25519 |ecdsa-sha2-",  "language": "SSH key" },
    { "pattern": "^%YAML|^---\n",             "language": "YAML" },
    { "pattern": "\\{\\s*\"",                 "language": "JSON" },
    { "pattern": "^\\[DEFAULT\\]|^\\[global\\]", "language": "INI" },
    { "pattern": "^FROM |^RUN |^COPY |^ENV |^EXPOSE ", "language": "Dockerfile" }
  ],

  "path_patterns": [
    { "path_contains": ".github/workflows/", "language": "GitHub Actions" },
    { "path_contains": ".gitlab-ci",         "language": "GitLab CI" },
    { "path_contains": "ansible",            "language": "Ansible" },
    { "path_contains": "k8s/",              "language": "Kubernetes manifest" },
    { "path_contains": "kubernetes/",       "language": "Kubernetes manifest" },
    { "path_contains": "helm/",             "language": "Helm" },
    { "path_contains": "charts/",           "language": "Helm" }
