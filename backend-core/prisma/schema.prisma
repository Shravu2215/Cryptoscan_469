// CryptoScan / ECDAT - Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String?   // hashed with bcrypt, optional for oauth
  name       String?
  provider   String   @default("local")
  providerId String?
  avatar     String?
  role       String   @default("Developer")
  createdAt  DateTime @default(now())

  repos     Repo[]
  auditLogs AuditLog[]
  sessions  Session[]
}

// Refresh-token session record. One row per issued refresh token.
// revokedAt is set on logout or on refresh-token reuse (rotation breach).
model Session {
  id               String    @id @default(uuid())
  jti              String    @unique  // refresh token jti
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  refreshTokenHash String    // SHA-256 of the raw refresh token
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([jti])
}

model Repo {
  id                  String        @id @default(uuid())
  name                String
  filePath            String        // path on disk where uploaded repo/zip is stored
  uploadedBy          String
  user                User          @relation(fields: [uploadedBy], references: [id])
  businessContext     String?       @default("STANDARD") // CRITICAL, IMPORTANT, STANDARD
  businessCriticality String        @default("Not tagged") // CRITICAL, HIGH, MEDIUM, LOW
  createdAt           DateTime      @default(now())

  scans        Scan[]
  cbomVersions CbomVersion[]
}

model Scan {
  id             String   @id @default(uuid())
  repoId         String
  repo           Repo     @relation(fields: [repoId], references: [id])
  status         String   @default("PENDING")
  commitHash     String?
  scannerVersion String?  @default("2.0.0")
  createdAt      DateTime @default(now())
  completedAt    DateTime?

  findings    Finding[]
  cbom        Cbom?
  anchor      Anchor?
  cbomVersion CbomVersion?
  runtimeRuns RuntimeRun[]
  fileManifest FileManifestEntry[]
}

model RuntimeRun {
  id          String   @id @default(uuid())
  scanId      String?
  scan        Scan?    @relation(fields: [scanId], references: [id])
  language    String   // "python" | "node"
  command     String?
  environment String   @default("test") // "test" | "staging"
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  eventCount  Int      @default(0)
  createdAt   DateTime @default(now())

  events RuntimeEvent[]
}

model RuntimeEvent {
  id               String      @id @default(uuid())
  eventId          String      @unique // UUID from tracer
  runId            String
  run              RuntimeRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  timestamp        DateTime    @default(now())
  language         String      // "python" | "node"
  library          String
  operation        String      // hash, encrypt, decrypt, sign, verify, keygen, kdf, hmac, tls, other
  algorithm        String      // normalized canonical name
  keySize          Int?
  mode             String?
  padding          String?
  curve            String?
  callFile         String
  callLine         Int
  callFunction     String
  matchedFindingId String?
  createdAt        DateTime    @default(now())

  @@index([runId, algorithm])
}

model Finding {
  id                String   @id @default(uuid())
  scanId            String
  scan              Scan     @relation(fields: [scanId], references: [id])
  filePath          String   
  lineNumber        Int?
  algorithm         String   
  library           String?  
  usage             String?  
  keySize           Int?
  quantumStatus     String?  
  severity          String   
  description       String   
  recommendation    String?
  confidence        String   @default("Likely")
  suppressed        Boolean  @default(false)
  suppressionReason String?
  status            String   @default("ACTIVE") // ACTIVE, RESOLVED
  detection         String?  @default("AST")    // display-ready detection method (AST, REGEX, ...)
  detection_method  String?  @default("ast")    // raw detection method key
  language          String?  @default("Unknown") // language display name from language registry
  createdAt         DateTime @default(now())
}


model Cbom {
  id          String   @id @default(uuid())
  scanId      String   @unique
  scan        Scan     @relation(fields: [scanId], references: [id])
  format      String   @default("CycloneDX-lite")
  content     String   // full CBOM document (CycloneDX-lite JSON)
  quantumRisk String?  // overall quantum risk rating
  createdAt   DateTime @default(now())
}

// Append-only evidence of security-relevant actions. `entryHash` commits to
// this record and the preceding one, making deletion/reordering detectable.
model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  action       String
  method       String
  path         String
  statusCode   Int
  requestHash  String?
  previousHash String?
  entryHash    String   @unique
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

model Anchor {
  id          String   @id @default(uuid())
  scanId      String   @unique
  scan        Scan     @relation(fields: [scanId], references: [id])
  contentHash String   // hash of findings+cbom that was anchored
  txHash      String   // REAL blockchain transaction hash — never fake this
  signature   String   // real digital signature
  network     String   // e.g. sepolia
  createdAt   DateTime @default(now())
}

model CbomVersion {
  id            String   @id @default(uuid())
  repoId        String
  repo          Repo     @relation(fields: [repoId], references: [id])
  scanId        String   @unique
  scan          Scan     @relation(fields: [scanId], references: [id])
  versionNumber Int
  versionLabel  String   // e.g. CBOM-v1, CBOM-v2
  content       String   // full CycloneDX 1.6 CBOM document JSON
  createdAt     DateTime @default(now())
}

model ThreatScenario {
  id              String   @id @default(uuid())
  scanId          String
  name            String
  familyTimelines Json
  source          String
  citationNote    String
  editable        Boolean  @default(true)
  createdBy       String
  createdAt       DateTime @default(now())

  @@index([scanId])
}

model ThreatAssessment {
  id                     String   @id @default(uuid())
  scanId                 String
  assetId                String
  scenarioId             String
  dataLifetimeYears      Float
  migrationTimeYears     Float
  pBreakBeforeMigration  Float
  pMoscaViolated         Float
  p10                    Float
  p50                    Float
  p90                    Float
  riskBand               String
  iterations             Int
  seed                   Int
  createdAt              DateTime @default(now())

  @@index([scanId])
  @@index([scanId, scenarioId])
}

model SensitiveDataField {
  id                  String   @id @default(uuid())
  scanId              String
  fieldId             String
  dataClass           String
  location            Json
  retentionYears      Float
  retentionSource     String
  protectedBy         String[]
  detectionConfidence Float
  lineageConfidence   Float
  evidence            String[]
  createdAt           DateTime @default(now())

  @@index([scanId])
}

model DataExposure {
  id                   String   @id @default(uuid())
  scanId               String
  fieldId              String
  assetId              String
  scenarioId           String
  exposureProbability  Float
  sensitivityWeight    Float
  retentionYears       Float
  explanation          String
  createdAt            DateTime @default(now())

  @@index([scanId])
  @@index([scanId, scenarioId])
}

model MigrationSchedule {
  id        String   @id @default(uuid())
  scanId    String
  input     Json
  result    Json
  createdAt DateTime @default(now())

  @@index([scanId])
}

model FileManifestEntry {
  id        String   @id @default(uuid())
  scanId    String
  scan      Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  filePath  String
  status    String   // SCANNED, SKIPPED, ERROR
  sha256    String?
  size      Int?
  reason    String?  // If skipped/error
  createdAt DateTime @default(now())

  @@index([scanId])
  @@index([scanId, filePath])
}

model CryptoTwinRun {
  id                  String   @id @default(uuid())
  scanId              String
  status              String   @default("RUNNING") // RUNNING, COMPLETED, FAILED
  verdict             String   @default("NOT RUN") // PRODUCTION READY, PRODUCTION NOT READY, NOT RUN
  migrationConfidence Float    @default(0)
  weaknessCount       Int      @default(0)
  testsRun            Int      @default(0)
  testsPassed         Int      @default(0)
  fixesApplied        Int      @default(0)
  remainingBlockers   Int      @default(0)
  attackPaths         Json?
  stages              Json?
  tests               Json?
  patches             Json?
  aiIterations        Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([scanId])
}

model CryptoShieldAsset {
  id              String   @id @default(uuid())
  assetId         String   @unique
  assetType       String   // PRIVATE_KEY, CERTIFICATE, API_CREDENTIAL, TOKEN_SIGNER
  fingerprint     String   // One-way SHA-256 fingerprint (shortened preview e.g. 8f3a...9bd)
  algorithm       String   // RSA-2048, ECDSA-P256, AES-256-GCM
  application     String   // Payment Service, Auth Service
  environment     String   @default("production") // production, staging, dev
  owner           String   @default("SecOps Team")
  sourceFile      String?
  sourceLine      Int?
  criticality     String   @default("HIGH") // CRITICAL, HIGH, MEDIUM, LOW
  allowedServices Json     // Array of allowed service names
  status          String   @default("PROTECTED") // PROTECTED, SUSPECTED_MISUSE, BLOCKED
  createdAt       DateTime @default(now())

  policies CryptoShieldPolicy[]
  events   CryptoShieldEvent[]
}

model CryptoShieldPolicy {
  id                String            @id @default(uuid())
  assetId           String
  asset             CryptoShieldAsset @relation(fields: [assetId], references: [assetId], onDelete: Cascade)
  allowedService    String
  allowedOperations Json              // Array: ["SIGN", "VERIFY", "ENCRYPT", "DECRYPT"]
  environment       String            @default("production")
  status            String            @default("ACTIVE") // ACTIVE, DISABLED
  createdAt         DateTime          @default(now())

  @@index([assetId])
}

model CryptoShieldEvent {
  id                    String             @id @default(uuid())
  eventId               String             @unique
  timestamp             DateTime           @default(now())
  assetId               String
  asset                 CryptoShieldAsset  @relation(fields: [assetId], references: [assetId], onDelete: Cascade)
  requestingApplication String
  requestedOperation    String             // SIGN, VERIFY, ENCRYPT, DECRYPT
  environment           String
  decision              String             // ALLOWED, BLOCKED
  reason                String
  severity              String             // CRITICAL, HIGH, MEDIUM, LOW
  createdAt             DateTime           @default(now())

  @@index([assetId])
}

model CryptoShieldRecoveryPlan {
  id                   String   @id @default(uuid())
  assetId              String
  eventId              String?
  issue                String
  potentialImpact      String
  recommendedAction    String
  cryptoTwinValidation Json?    // Result of CryptoTwin test recovery simulation
  approvalStatus       String   @default("PENDING") // PENDING, APPROVED, DECLINED
  approvedBy           String?
  approvedAt           DateTime?
  overrideReason       String?
  createdAt            DateTime @default(now())

  @@index([assetId])
}

model CryptoShieldAuditLog {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())
  action    String
  user      String
  assetId   String?
  result    String
  details   String?
  createdAt DateTime @default(now())
}


