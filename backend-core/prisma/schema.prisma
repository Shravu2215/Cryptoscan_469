// CryptoScan / ECDAT - Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String?   // hashed with bcrypt, optional for oauth
  name       String?
  provider   String   @default("local")
  providerId String?
  avatar     String?
  role       String   @default("Developer")
  createdAt  DateTime @default(now())

  repos     Repo[]
  auditLogs AuditLog[]
  sessions  Session[]
}

// Refresh-token session record. One row per issued refresh token.
// revokedAt is set on logout or on refresh-token reuse (rotation breach).
model Session {
  id               String    @id @default(uuid())
  jti              String    @unique  // refresh token jti
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  refreshTokenHash String    // SHA-256 of the raw refresh token
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([jti])
}

model Repo {
  id                  String        @id @default(uuid())
  name                String
  filePath            String        // path on disk where uploaded repo/zip is stored
  uploadedBy          String
  user                User          @relation(fields: [uploadedBy], references: [id])
  businessContext     String?       @default("STANDARD") // CRITICAL, IMPORTANT, STANDARD
  businessCriticality String        @default("Not tagged") // CRITICAL, HIGH, MEDIUM, LOW
  createdAt           DateTime      @default(now())

  scans        Scan[]
  cbomVersions CbomVersion[]
}

model Scan {
  id             String   @id @default(uuid())
  repoId         String
  repo           Repo     @relation(fields: [repoId], references: [id])
  status         String   @default("PENDING")
  commitHash     String?
  scannerVersion String?  @default("2.0.0")
  createdAt      DateTime @default(now())
  completedAt    DateTime?

  findings    Finding[]
  cbom        Cbom?
  anchor      Anchor?
  cbomVersion CbomVersion?
  runtimeRuns RuntimeRun[]
}

model RuntimeRun {
  id          String   @id @default(uuid())
  scanId      String?
  scan        Scan?    @relation(fields: [scanId], references: [id])
  language    String   // "python" | "node"
  command     String?
  environment String   @default("test") // "test" | "staging"
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  eventCount  Int      @default(0)
  createdAt   DateTime @default(now())

  events RuntimeEvent[]
}

model RuntimeEvent {
  id               String      @id @default(uuid())
  eventId          String      @unique // UUID from tracer
  runId            String
  run              RuntimeRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  timestamp        DateTime    @default(now())
  language         String      // "python" | "node"
  library          String
  operation        String      // hash, encrypt, decrypt, sign, verify, keygen, kdf, hmac, tls, other
  algorithm        String      // normalized canonical name
  keySize          Int?
  mode             String?
  padding          String?
  curve            String?
  callFile         String
  callLine         Int
  callFunction     String
  matchedFindingId String?
  createdAt        DateTime    @default(now())

  @@index([runId, algorithm])
}

model Finding {
  id                String   @id @default(uuid())
  scanId            String
  scan              Scan     @relation(fields: [scanId], references: [id])
  filePath          String   
  lineNumber        Int?
  algorithm         String   
  library           String?  
  usage             String?  
  keySize           Int?
  quantumStatus     String?  
  severity          String   
  description       String   
  recommendation    String?
  confidence        String   @default("Likely")
  suppressed        Boolean  @default(false)
  suppressionReason String?
  status            String   @default("ACTIVE") // ACTIVE, RESOLVED
  detection         String?  @default("AST")    // display-ready detection method (AST, REGEX, ...)
  detection_method  String?  @default("ast")    // raw detection method key
  language          String?  @default("Unknown") // language display name from language registry
  createdAt         DateTime @default(now())
}


model Cbom {
  id          String   @id @default(uuid())
  scanId      String   @unique
  scan        Scan     @relation(fields: [scanId], references: [id])
  format      String   @default("CycloneDX-lite")
  content     String   // full CBOM document (CycloneDX-lite JSON)
  quantumRisk String?  // overall quantum risk rating
  createdAt   DateTime @default(now())
}

// Append-only evidence of security-relevant actions. `entryHash` commits to
// this record and the preceding one, making deletion/reordering detectable.
model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  action       String
  method       String
  path         String
  statusCode   Int
  requestHash  String?
  previousHash String?
  entryHash    String   @unique
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

model Anchor {
  id          String   @id @default(uuid())
  scanId      String   @unique
  scan        Scan     @relation(fields: [scanId], references: [id])
  contentHash String   // hash of findings+cbom that was anchored
  txHash      String   // REAL blockchain transaction hash — never fake this
  signature   String   // real digital signature
  network     String   // e.g. sepolia
  createdAt   DateTime @default(now())
}

model CbomVersion {
  id            String   @id @default(uuid())
  repoId        String
  repo          Repo     @relation(fields: [repoId], references: [id])
  scanId        String   @unique
  scan          Scan     @relation(fields: [scanId], references: [id])
  versionNumber Int
  versionLabel  String   // e.g. CBOM-v1, CBOM-v2
  content       String   // full CycloneDX 1.6 CBOM document JSON
  createdAt     DateTime @default(now())
}

model ThreatScenario {
  id              String   @id @default(uuid())
  scanId          String
  name            String
  familyTimelines Json
  source          String
  citationNote    String
  editable        Boolean  @default(true)
  createdBy       String
  createdAt       DateTime @default(now())

  @@index([scanId])
}

model ThreatAssessment {
  id                     String   @id @default(uuid())
  scanId                 String
  assetId                String
  scenarioId             String
  dataLifetimeYears      Float
  migrationTimeYears     Float
  pBreakBeforeMigration  Float
  pMoscaViolated         Float
  p10                    Float
  p50                    Float
  p90                    Float
  riskBand               String
  iterations             Int
  seed                   Int
  createdAt              DateTime @default(now())

  @@index([scanId])
  @@index([scanId, scenarioId])
}

model SensitiveDataField {
  id                  String   @id @default(uuid())
  scanId              String
  fieldId             String
  dataClass           String
  location            Json
  retentionYears      Float
  retentionSource     String
  protectedBy         String[]
  detectionConfidence Float
  lineageConfidence   Float
  evidence            String[]
  createdAt           DateTime @default(now())

  @@index([scanId])
}

model DataExposure {
  id                   String   @id @default(uuid())
  scanId               String
  fieldId              String
  assetId              String
  scenarioId           String
  exposureProbability  Float
  sensitivityWeight    Float
  retentionYears       Float
  explanation          String
  createdAt            DateTime @default(now())

  @@index([scanId])
  @@index([scanId, scenarioId])
}

model MigrationSchedule {
  id        String   @id @default(uuid())
  scanId    String
  input     Json
  result    Json
  createdAt DateTime @default(now())

  @@index([scanId])
}

model NetworkCapture {
  id        String   @id @default(uuid())
  scanId    String?
  source    String   @default("json") // "json" | "pcap" | "openssl"
  fileName  String?
  createdAt DateTime @default(now())

  observations NetworkObservation[]
  @@index([scanId])
}

model NetworkObservation {
  id                   String          @id @default(uuid())
  captureId            String
  capture              NetworkCapture  @relation(fields: [captureId], references: [id], onDelete: Cascade)
  host                 String?
  port                 Int?
  protocol             String          @default("TLS")
  protocolVersion      String          @default("TLSv1.3")
  cipherSuite          String?
  keyExchange          String?
  signatureAlgorithm   String?
  certificateKeyType   String?
  certificateKeySize   Int?
  normalizedAlgorithms Json
  quantumVulnerable    Boolean         @default(false)
  createdAt            DateTime        @default(now())

  @@index([captureId])
}

model TriangulationResult {
  id                           String   @id @default(uuid())
  scanId                       String
  runIds                       Json     // array of run IDs used
  captureIds                   Json     // array of capture IDs used
  algorithm                    String
  keySize                      Int?
  classification               String   // "Confirmed Active" | "Static Only" | "Runtime Only" | "Network Only"
  confidence                   String   @default("medium") // "high" | "medium" | "low"
  confidenceReason             String
  coverageNote                 String
  possibleStaticFalseNegative Boolean  @default(false)
  quantumVulnerable            Boolean  @default(false)
  staticFindingId              String?
  location                     String
  evidence                     Json     // consolidated EvidenceItems array
  createdAt                    DateTime @default(now())

  @@index([scanId])
  @@index([scanId, classification])
}

model HistoryScan {
  id              String           @id @default(uuid())
  repoName        String
  ref             String           @default("HEAD")
  commitCount     Int
  firstCommitDate DateTime
  lastCommitDate  DateTime
  scannerVersion  String           @default("1.0.0")
  rulesetHash     String?
  cacheHits       Int              @default(0)
  cacheMisses     Int              @default(0)
  createdAt       DateTime         @default(now())

  findings        HistoryFinding[]
  secrets         HistorySecret[]
}

model HistoryFinding {
  id                    String      @id @default(uuid())
  historyScanId         String
  historyScan           HistoryScan @relation(fields: [historyScanId], references: [id], onDelete: Cascade)
  findingKey            String
  algorithm             String
  keySize               Int?
  file                  String
  function              String
  classification        String      // "weak" | "quantum_vulnerable" | "both" | "ok"
  introducedCommit      String
  introducedCommitIndex Int
  introducedDate        DateTime
  removedCommit         String?
  removedCommitIndex    Int?
  removedDate           DateTime?
  exposureCommits       Int
  exposureDays          Int
  stillPresent          Boolean     @default(true)
  createdAt             DateTime    @default(now())

  @@index([historyScanId])
  @@index([findingKey])
}

model HistorySecret {
  id                 String      @id @default(uuid())
  historyScanId      String
  historyScan        HistoryScan @relation(fields: [historyScanId], references: [id], onDelete: Cascade)
  secretType         String
  file               String
  addedCommit        String
  addedCommitIndex   Int
  addedDate          DateTime
  removedCommit      String?
  removedCommitIndex Int?
  removedDate        DateTime?
  presentInHistory   Boolean     @default(true)
  fingerprint        String      // Truncated SHA-256 hash (redacted fingerprint) - NO secret content column
  createdAt          DateTime    @default(now())

  @@index([historyScanId])
}


