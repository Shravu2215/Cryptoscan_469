// CryptoScan / ECDAT - Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String?   // hashed with bcrypt, optional for oauth
  name       String?
  provider   String   @default("local")
  providerId String?
  avatar     String?
  role       String   @default("Developer")
  createdAt  DateTime @default(now())

  repos     Repo[]
  auditLogs AuditLog[]
  sessions  Session[]
}

// Refresh-token session record. One row per issued refresh token.
// revokedAt is set on logout or on refresh-token reuse (rotation breach).
model Session {
  id               String    @id @default(uuid())
  jti              String    @unique  // refresh token jti
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  refreshTokenHash String    // SHA-256 of the raw refresh token
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([jti])
}

model Repo {
  id                  String        @id @default(uuid())
  name                String
  filePath            String        // path on disk where uploaded repo/zip is stored
  uploadedBy          String
  user                User          @relation(fields: [uploadedBy], references: [id])
  businessContext     String?       @default("STANDARD") // CRITICAL, IMPORTANT, STANDARD
  businessCriticality String        @default("Not tagged") // CRITICAL, HIGH, MEDIUM, LOW
  createdAt           DateTime      @default(now())

  scans        Scan[]
  cbomVersions CbomVersion[]
}

model Scan {
  id             String   @id @default(uuid())
  repoId         String
  repo           Repo     @relation(fields: [repoId], references: [id])
  status         String   @default("PENDING")
  commitHash     String?
  scannerVersion String?  @default("2.0.0")
  createdAt      DateTime @default(now())
  completedAt    DateTime?

  findings    Finding[]
  cbom        Cbom?
  anchor      Anchor?
  cbomVersion CbomVersion?
  runtimeRuns RuntimeRun[]
  fileManifest FileManifestEntry[]
}

model RuntimeRun {
  id          String   @id @default(uuid())
  scanId      String?
  scan        Scan?    @relation(fields: [scanId], references: [id])
  userId      String   @default("")
  ingestTokenHash String @default("")
  targetOrigin String  @default("")
  cryptoscanOrigin String @default("")
  status      String   @default("ready")
  language    String   // "python" | "node"
  command     String?
  environment String   @default("test") // "test" | "staging"
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  lastEventAt DateTime?
  stoppedAt   DateTime?
  eventCount  Int      @default(0)
  createdAt   DateTime @default(now())

  events RuntimeEvent[]
  findings Finding[]
}

model RuntimeEvent {
  id               String      @id @default(uuid())
  eventId          String      @unique // UUID from tracer
  runId            String
  run              RuntimeRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  timestamp        DateTime    @default(now())
  language         String      // "python" | "node"
  library          String
  operation        String      // hash, encrypt, decrypt, sign, verify, keygen, kdf, hmac, tls, other
  algorithm        String      // normalized canonical name
  keySize          Int?
  mode             String?
  padding          String?
  curve            String?
  callFile         String
  callLine         Int
  callFunction     String
  source           String   @default("crypto")
  keyInfo          String   @default("{}")
  callerScript     String   @default("unknown:0")
  hostOrigin       String   @default("")
  scheme           String   @default("")
  port             Int      @default(0)
  crossOrigin      Boolean  @default(false)
  count            Int      @default(1)
  matchedFindingId String?
  createdAt        DateTime    @default(now())

  @@index([runId, algorithm])
}

model Finding {
  id                String   @id @default(uuid())
  scanId            String
  scan              Scan     @relation(fields: [scanId], references: [id])
  filePath          String   
  lineNumber        Int?
  algorithm         String   
  library           String?  
  usage             String?  
  keySize           Int?
  quantumStatus     String?  
  severity          String   
  description       String   
  recommendation    String?
  confidence        String   @default("Likely")
  suppressed        Boolean  @default(false)
  suppressionReason String?
  status            String   @default("ACTIVE") // ACTIVE, RESOLVED
  detection         String?  @default("AST")    // display-ready detection method (AST, REGEX, ...)
  detection_method  String?  @default("ast")    // raw detection method key
  language          String?  @default("Unknown") // language display name from language registry
  source            String   @default("static")
  sessionId         String?
  runtimeSession    RuntimeRun? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  operation         String?
  callSite          String?
  mode              String?
  curve             String?
  hash              String?
  observedAt        DateTime?
  count             Int      @default(1)
  createdAt         DateTime @default(now())

  @@index([sessionId])
}


model Cbom {
  id          String   @id @default(uuid())
  scanId      String   @unique
  scan        Scan     @relation(fields: [scanId], references: [id])
  format      String   @default("CycloneDX-lite")
  content     String   // full CBOM document (CycloneDX-lite JSON)
  quantumRisk String?  // overall quantum risk rating
  createdAt   DateTime @default(now())
}

// Append-only evidence of security-relevant actions. `entryHash` commits to
// this record and the preceding one, making deletion/reordering detectable.
model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  action       String
  method       String
  path         String
  statusCode   Int
  requestHash  String?
  previousHash String?
  entryHash    String   @unique
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

model Anchor {
  id          String   @id @default(uuid())
  scanId      String   @unique
  scan        Scan     @relation(fields: [scanId], references: [id])
  contentHash String   // hash of findings+cbom that was anchored
  txHash      String   // REAL blockchain transaction hash — never fake this
  signature   String   // real digital signature
  network     String   // e.g. sepolia
  createdAt   DateTime @default(now())
}

model CbomVersion {
  id            String   @id @default(uuid())
  repoId        String
  repo          Repo     @relation(fields: [repoId], references: [id])
  scanId        String   @unique
  scan          Scan     @relation(fields: [scanId], references: [id])
  versionNumber Int
  versionLabel  String   // e.g. CBOM-v1, CBOM-v2
  content       String   // full CycloneDX 1.6 CBOM document JSON
  createdAt     DateTime @default(now())
}

model ThreatScenario {
  id              String   @id @default(uuid())
  scanId          String
  name            String
  familyTimelines Json
  source          String
  citationNote    String
  editable        Boolean  @default(true)
  createdBy       String
  createdAt       DateTime @default(now())

  @@index([scanId])
}

model ThreatAssessment {
  id                     String   @id @default(uuid())
  scanId                 String
  assetId                String
  scenarioId             String
  dataLifetimeYears      Float
  migrationTimeYears     Float
  pBreakBeforeMigration  Float
  pMoscaViolated         Float
  p10                    Float
  p50                    Float
  p90                    Float
  riskBand               String
  iterations             Int
  seed                   Int
  createdAt              DateTime @default(now())

  @@index([scanId])
  @@index([scanId, scenarioId])
}

model SensitiveDataField {
  id                  String   @id @default(uuid())
  scanId              String
  fieldId             String
  dataClass           String
  location            Json
  retentionYears      Float
  retentionSource     String
  protectedBy         String[]
  detectionConfidence Float
  lineageConfidence   Float
  evidence            String[]
  createdAt           DateTime @default(now())

  @@index([scanId])
}

model DataExposure {
  id                   String   @id @default(uuid())
  scanId               String
  fieldId              String
  assetId              String
  scenarioId           String
  exposureProbability  Float
  sensitivityWeight    Float
  retentionYears       Float
  explanation          String
  createdAt            DateTime @default(now())

  @@index([scanId])
  @@index([scanId, scenarioId])
}

model MigrationSchedule {
  id        String   @id @default(uuid())
  scanId    String
  input     Json
  result    Json
  createdAt DateTime @default(now())

  @@index([scanId])
}

model FileManifestEntry {
  id        String   @id @default(uuid())
  scanId    String
  scan      Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  filePath  String
  status    String   // SCANNED, SKIPPED, ERROR
  sha256    String?
  size      Int?
  reason    String?  // If skipped/error
  createdAt DateTime @default(now())

  @@index([scanId])
  @@index([scanId, filePath])
}

// CryptoTwin — sandbox migration & breach simulation run record
model CryptoTwinRun {
  id             String    @id @default(uuid())
  scanId         String?
  userId         String
  repoName       String    @default("")
  source         String    @default("direct")     // direct | uploaded
  status         String    @default("PENDING")    // PENDING | RUNNING | DONE | FAILED
  inputJson      String    @default("{}")         // serialized CryptoTwinInput
  stagesJson     String    @default("[]")         // stage status array
  attackPaths    String    @default("[]")         // breach simulation paths
  testsJson      String    @default("[]")         // test results
  patchLog       String    @default("[]")         // {file, before, after}[]
  aiIterations   String    @default("[]")         // AI fix attempts
  verdict        String?                           // PRODUCTION_READY | PRODUCTION_NOT_READY | INCONCLUSIVE
  confidence     Float?
  blockers       String    @default("[]")
  approval       String?                           // APPROVED | APPROVED_WITH_OVERRIDE | REJECTED | PENDING_REVIEW
  approvalBy     String?
  approvalAt     DateTime?
  approvalNote   String?
  overrideReason String?
  reportJson     String?
  errorMessage   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([scanId])
  @@index([userId])
}
