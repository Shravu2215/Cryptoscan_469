# Database configuration (PostgreSQL)
DATABASE_URL="postgresql://cryptoscan_user:cryptoscan_password@localhost:5432/cryptoscan"

# Set this to the same local URL for development; use a direct, non-pooler URL in production.
DIRECT_URL="$DATABASE_URL"

# ── JWT secrets ───────────────────────────────────────────────────────────────
# Both must be random strings of at least 32 characters and MUST differ from
# each other. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# ⚠️  NEVER commit real values. These placeholders will cause startup to fail.
JWT_ACCESS_SECRET="replace-with-a-random-string-of-at-least-32-chars"
JWT_REFRESH_SECRET="replace-with-a-different-random-string-of-at-least-32-chars"

# Required: base64-encoded 32-byte AES-256-GCM key.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

REDIS_URL=redis://redis:6379

# Server (default port 3000 to match frontend expectation)
PORT=3000

# File Upload limits
MAX_UPLOAD_SIZE_MB=50
MAX_EXTRACTED_SIZE_MB=250

# Blockchain configuration
CHAIN_MODE=public
PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
RPC_URL=http://127.0.0.1:8545
PRIVATE_KEY=

# Required in production: comma-separated list of allowed frontend origins
# for CORS (e.g. https://app.example.com,https://admin.example.com).
ALLOWED_ORIGINS=

# NODE_ENV=production enables strict CORS, secure cookies, and fail-fast
# validation of the vars above.
NODE_ENV=development

# Key management for the classical (ECDSA/secp256k1) anchoring signature.
# "env" (default) reads PRIVATE_KEY directly — fine for local/dev only.
# "aws-kms" delegates signing to an asymmetric ECC_SECG_P256K1 KMS key;
# set AWS_KMS_KEY_ID/AWS_REGION and standard AWS credentials, and install
# the optional dependency @aws-sdk/client-kms.
KMS_PROVIDER=env
AWS_KMS_KEY_ID=
AWS_REGION=

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
# Base URL the browser is redirected back to after OAuth (no trailing slash),
# e.g. https://app.example.com or http://localhost:3000 in dev.
FRONTEND_URL=http://localhost:3000

# ── Hostile-Repository Hardening (Req 2, 3, 4, 5) ────────────────────────────
# Archive safety limits (applies to /repos/upload and /repos/github ZIP downloads)
MAX_UPLOAD_SIZE_MB=50           # max compressed archive size
MAX_EXTRACTED_SIZE_MB=512       # max total uncompressed bytes in archive
MAX_COMPRESSION_RATIO=100       # max ratio uncompressed/compressed per entry (zip-bomb)
MAX_ARCHIVE_FILES=50000         # max number of entries in archive
MAX_ARCHIVE_DEPTH=20            # max directory nesting depth in archive
MAX_SINGLE_FILE_MB=50           # max single-entry uncompressed size

# Scanner resource limits
SCANNER_MAX_FILE_SIZE_MB=10     # max single file the scanner will read
SCANNER_MAX_TOTAL_SIZE_MB=512   # max total bytes read across all files in one scan
SCANNER_MAX_FILES=50000         # max files per scan
SCANNER_MAX_AST_DEPTH=50        # max AST tree depth
SCANNER_MAX_AST_NODES=100000    # max AST node count per file
SCANNER_PER_FILE_TIMEOUT_SEC=30 # per-file analysis timeout in seconds
SCANNER_SCAN_TIMEOUT_SEC=600    # whole-scan timeout in seconds (10 min)
SCANNER_MAX_LINE_LEN=2000       # lines longer than this → file treated as minified
SCANNER_MAX_SNIPPET_LENGTH=500  # max code-snippet chars in any finding

# Input validation
# Comma-separated HTTPS hosts allowed for repository import (beyond github.com)
ALLOWED_GIT_HOSTS=github.com,gitlab.com,bitbucket.org
# Set to "false" to disable cloud-metadata IP block (dev only, never in prod)
SSRF_BLOCK_METADATA=true

# Docker sandbox limits for the scanner container (docker-compose only)
SCANNER_CPU_LIMIT=1.0
SCANNER_MEMORY_LIMIT=1G
SCANNER_PIDS_LIMIT=128
