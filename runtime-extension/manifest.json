{
  "manifest_version": 3,
  "name": "CryptoScan Runtime Observer",
  "version": "1.0.0",
  "description": "Observe cryptographic operations and transport metadata during a user-started website session.",
  "permissions": ["storage", "scripting", "tabs", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CryptoScan Runtime Observer",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://localhost:*/*",
        "http://127.0.0.1/*",
        "http://127.0.0.1:*/*",
        "https://*.vercel.app/*",
        "https://*.onrender.com/*"
      ],
      "js": ["frontend-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["target-content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["main-hook.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
