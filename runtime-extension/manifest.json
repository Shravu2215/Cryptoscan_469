{
  "manifest_version": 3,
  "name": "CryptoScan Runtime Observer",
  "version": "1.0.0",
  "description": "Observe cryptographic operations and transport metadata during a user-started website session.",
  "permissions": ["storage", "scripting", "tabs", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CryptoScan Runtime Observer",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["target-content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["main-hook.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
